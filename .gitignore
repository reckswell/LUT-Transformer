*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/

# Editors and local settings
.vscode/
.idea/
.claude/settings.local.json
.env
.env.*

# Vendor tool output (for the later HLS phase)
.Xil/
*.log
*.jou
hls/**/build/
